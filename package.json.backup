{
  "name": "charlotte",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');['.output','.nuxt','.nitro'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "build": "prisma generate && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "nuxt prepare && prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-vndb-tags": "tsx scripts/backfill-vndb-tags.ts",
    "start": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop charlotte",
    "restart": "pm2 restart charlotte",
    "reload": "pm2 reload charlotte",
    "logs": "pm2 logs charlotte",
    "status": "pm2 status",
    "icons": "node scripts/generate-icon-list.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@nuxt/content": "^2.13.4",
    "@nuxt/image": "^2.0.0",
    "@prisma/client": "^5.22.0",
    "@sidebase/nuxt-auth": "^0.9.4",
    "@tiptap/core": "~3.18.0",
    "@tiptap/extension-code-block-lowlight": "~3.18.0",
    "@tiptap/extension-color": "~3.18.0",
    "@tiptap/extension-highlight": "~3.18.0",
    "@tiptap/extension-image": "~3.18.0",
    "@tiptap/extension-link": "~3.18.0",
    "@tiptap/extension-placeholder": "~3.18.0",
    "@tiptap/extension-text-align": "~3.18.0",
    "@tiptap/extension-text-style": "~3.18.0",
    "@tiptap/extension-underline": "~3.18.0",
    "@tiptap/pm": "~3.18.0",
    "@tiptap/starter-kit": "~3.18.0",
    "@tiptap/vue-3": "~3.18.0",
    "@vueuse/core": "^11.2.0",
    "bcryptjs": "^2.4.3",
    "isomorphic-dompurify": "^3.7.1",
    "jsonwebtoken": "^9.0.2",
    "lowlight": "^3.3.0",
    "nodemailer": "^6.9.16",
    "nuxt": "^3.14.0",
    "otplib": "^13.3.0",
    "pinyin": "^4.0.0",
    "qrcode": "^1.5.4",
    "redis": "^4.7.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.33.5",
    "uuid": "^11.0.3",
    "vditor": "^3.11.2",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/kit": "^3.21.0",
    "@nuxtjs/color-mode": "^3.5.1",
    "@nuxtjs/sitemap": "^7.6.0",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^2.2.12"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/extension-list": "~3.18.0",
      "@tiptap/extension-bullet-list": "~3.18.0",
      "@tiptap/extension-ordered-list": "~3.18.0",
      "@tiptap/extension-list-item": "~3.18.0"
    }
  }
}
