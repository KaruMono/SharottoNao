{
  "name": "charlotte",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');['.output','.nuxt','.nitro'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "build": "prisma generate && node --disable-warning=ExperimentalWarning --disable-warning=DEP0155 ./node_modules/nuxt/bin/nuxt.mjs build",
    "dev": "node --disable-warning=ExperimentalWarning --disable-warning=DEP0155 ./node_modules/nuxt/bin/nuxt.mjs dev",
    "generate": "node --disable-warning=ExperimentalWarning --disable-warning=DEP0155 ./node_modules/nuxt/bin/nuxt.mjs generate",
    "preview": "node --disable-warning=ExperimentalWarning --disable-warning=DEP0155 ./node_modules/nuxt/bin/nuxt.mjs preview",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "node --disable-warning=ExperimentalWarning --disable-warning=DEP0155 ./node_modules/nuxt/bin/nuxt.mjs prepare && prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-vndb-tags": "tsx scripts/backfill-vndb-tags.ts",
    "start": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop charlotte",
    "restart": "pm2 restart charlotte",
    "reload": "pm2 reload charlotte",
    "logs": "pm2 logs charlotte",
    "status": "pm2 status",
    "icons": "node scripts/generate-icon-list.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@nuxt/content": "^3.15.2",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@prisma/client": "^5.22.0",
    "@sidebase/nuxt-auth": "^0.9.4",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-code-block-lowlight": "^3.30.3",
    "@tiptap/extension-color": "^3.30.3",
    "@tiptap/extension-highlight": "^3.30.3",
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-link": "^3.30.3",
    "@tiptap/extension-placeholder": "^3.30.3",
    "@tiptap/extension-text-align": "^3.30.3",
    "@tiptap/extension-text-style": "^3.30.3",
    "@tiptap/extension-underline": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@tiptap/vue-3": "^3.30.3",
    "@vueuse/core": "^11.2.0",
    "bcryptjs": "^2.4.3",
    "isomorphic-dompurify": "^3.7.1",
    "jsonwebtoken": "^9.0.2",
    "lowlight": "^3.3.0",
    "nodemailer": "^9.0.5",
    "nuxt": "^4.5.2",
    "otplib": "^13.3.0",
    "pinyin": "^4.0.0",
    "qrcode": "^1.5.4",
    "redis": "^4.7.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.3",
    "uuid": "^11.0.3",
    "vditor": "^3.11.2",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@nuxt/kit": "^4.5.2",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/sitemap": "^8.5.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^2.2.12"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/extension-list": "~3.18.0",
      "@tiptap/extension-bullet-list": "~3.18.0",
      "@tiptap/extension-ordered-list": "~3.18.0",
      "@tiptap/extension-list-item": "~3.18.0"
    }
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "vue-demi@0.14.10": true
  }
}
