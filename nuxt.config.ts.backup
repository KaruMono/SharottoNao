    defaults: {
      changefreq: 'daily',
      priority: 0.7,
    },
  },

  css: [
    '~/assets/css/main.css',
  ],

  auth: {
    isEnabled: true,
    originEnvKey: 'NUXT_PUBLIC_SITE_URL',
    provider: {
      type: 'local',
      endpoints: {
        signIn: { path: '/login', method: 'post' },
        signOut: { path: '/logout', method: 'post' },
        signUp: { path: '/register', method: 'post' },
        getSession: { path: '/session', method: 'get' },
      },
      pages: {
        login: '/login',
      },
      token: {
        signInResponseTokenPointer: '/token',
        maxAgeInSeconds: 60 * 60 * 24 * 7, // 7 days
        headerName: 'Authorization',
        type: 'Bearer',
      },
      session: {
        dataType: {
          id: 'number',
          username: 'string',
          email: 'string',
          avatar: 'string | null',
          role: 'string',
          nsfwMode: 'string',
        },
        dataResponsePointer: '/',
      },
    },
    globalAppMiddleware: false,
  },

  content: {
    documentDriven: false,
    highlight: {
      theme: 'github-dark',
    },
    markdown: {
      toc: {
        depth: 3,
        searchDepth: 3,
      },
    },
  },

  runtimeConfig: {
    // 私有配置（仅服务端可用）
    authSecret: process.env.NUXT_AUTH_SECRET,
    // 站间私有 API 密钥，仅服务端读取
    // 留空作为默认值，生产环境由 NUXT_PRIVATE_API_KEY 在运行时注入，避免构建产物携带密钥
    privateApiKey: '',
    // Redis 配置（可选，不配置则使用内存缓存）
    redisUrl: process.env.REDIS_URL || '',
    trustProxy: process.env.TRUST_PROXY === 'true',
    smtp: {
      host: process.env.SMTP_HOST,
      port: process.env.SMTP_PORT,
      user: process.env.SMTP_USER,
      pass: process.env.SMTP_PASS,
      from: process.env.SMTP_FROM,
      fromName: process.env.SMTP_FROM_NAME || '',
      secure: process.env.SMTP_SECURE || 'auto',
      ignoreTlsErrors: process.env.SMTP_IGNORE_TLS_ERRORS === 'true',
    },
    s3: {
      enabled: process.env.S3_ENABLED === 'true',
      endpoint: process.env.S3_ENDPOINT,
      region: process.env.S3_REGION,
      bucket: process.env.S3_BUCKET,
      accessKey: process.env.S3_ACCESS_KEY,
      secretKey: process.env.S3_SECRET_KEY,
      publicUrl: process.env.S3_PUBLIC_URL,
    },
    localUploadPath: process.env.LOCAL_UPLOAD_PATH || './uploads',
    releaseId,
    staticAssetRoot: process.env.CHARLOTTE_STATIC_ASSET_ROOT || '',
    distributedLockDir: process.env.CHARLOTTE_LOCK_DIR || '',
    indexNowKey: process.env.INDEXNOW_KEY,
    // 公开配置（客户端可用）
    public: {
      siteUrl: process.env.NUXT_PUBLIC_SITE_URL || 'http://localhost:3000',
      cdnUrl: process.env.NUXT_PUBLIC_CDN_URL || 'https://u.sb/css-cdn/',
      buildId,
    },
  },

  hooks: {
    // build 完成后断开 Prisma / Redis 连接，防止进程挂起
    close: disconnectServices,
