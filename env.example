# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/charlotte?schema=public

# Site Configuration
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_AUTH_SECRET=your-super-secret-key-change-in-production
# 站间私有 API 密钥（请使用随机长字符串；请求通过 X-API-Key 传递）
NUXT_PRIVATE_API_KEY=

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Charlotte
# SMTP_SECURE: auto (default, SSL on 465, STARTTLS on others), true (force SSL/TLS), false (no TLS)
SMTP_SECURE=auto
# Set to true to allow self-signed certificates (not recommended for production)
SMTP_IGNORE_TLS_ERRORS=false

# S3 Storage Configuration
S3_ENABLED=false
S3_ENDPOINT=https://s3.us-west-000.backblazeb2.com
S3_REGION=us-west-000
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
# S3 Public URL (optional, for CDN proxy)
# Leave empty to use S3_ENDPOINT/S3_BUCKET
# If using CF proxy without bucket name in URL, fill in the full proxy URL
S3_PUBLIC_URL=https://cdn.yourdomain.com

# Local Storage Path (used when S3_ENABLED=false)
LOCAL_UPLOAD_PATH=./uploads

# Redis Configuration (optional, for caching)
# Leave empty to use in-memory cache (Nuxt SWR)
# Format: redis://[[username][:password]@][host][:port][/db-number]
REDIS_URL=

# IndexNow Configuration
INDEXNOW_KEY=
